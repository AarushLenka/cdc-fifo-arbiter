import fifo_pkg::*;

module fifo_properties (
    input logic wclk,
    input logic wrst_n,
    input logic rclk,
    input logic rrst_n,
    input logic w_en,
    input logic r_en,
    input logic full,
    input logic empty,
    input logic [A_WIDTH:0] b_rptr,
    input logic [A_WIDTH:0] b_wptr,
    input logic [A_WIDTH:0] g_rptr,
    input logic [A_WIDTH:0] g_wptr,
    input logic [A_WIDTH:0] g_rptr_sync,
    input logic [A_WIDTH:0] g_wptr_sync
);

// ============================================================
// Reset Properties
// ============================================================

property write_reset_b_wptr;
     @(posedge wclk) !wrst_n |-> (b_wptr == '0);
endproperty

property write_reset_g_wptr;
    @(posedge wclk) !wrst_n |-> (g_wptr == '0);
endproperty

property write_reset_full;
     @(posedge wclk) !wrst_n |-> (!full);
endproperty

property read_reset_b_rptr;
     @(posedge rclk) !rrst_n |-> (b_rptr == '0);
endproperty

property read_reset_g_rptr;
    @(posedge rclk) !rrst_n |-> (g_rptr == '0);
endproperty

property read_reset_empty;
    @(posedge rclk) !rrst_n |-> (empty);
endproperty

assert property (write_reset_b_wptr) else $error("Write reset failed: b_wptr != 0");
assert property (write_reset_g_wptr) else $error("Write reset failed: g_wptr != 0");
assert property (write_reset_full)   else $error("Write reset failed: full not deasserted");
assert property (read_reset_b_rptr)  else $error("Read reset failed: b_rptr != 0");
assert property (read_reset_g_rptr)  else $error("Read reset failed: g_rptr != 0");
assert property (read_reset_empty)   else $error("Read reset failed: empty not asserted");


// ============================================================
// Write Pointer Properties
// ============================================================

property write_ptr_increment;
    @(posedge wclk) disable iff (!wrst_n)
    (~full && w_en) |=> (b_wptr == $past(b_wptr) + 1'b1);
endproperty

//overflow
property write_ptr_unchanged;
    @(posedge wclk) disable iff (!wrst_n)
    (full || ~w_en) |=> $stable(b_wptr);
endproperty

assert property (write_ptr_increment) else $error("Write pointer failed: b_wptr did not increment on valid write");
assert property (write_ptr_unchanged) else $error("Write pointer failed: b_wptr changed unexpectedly");


// ============================================================
// Read Pointer Properties
// ============================================================

property read_pointer_increment;
    @(posedge rclk) disable iff (!rrst_n)
    (~empty && r_en) |=> (b_rptr == $past(b_rptr) + 1'b1);
endproperty

//underflow
property read_pointer_unchanged;
    @(posedge rclk) disable iff (!rrst_n)
    (empty || ~r_en) |=> ($stable(b_rptr));
endproperty

assert property (read_pointer_increment) else $error("Read pointer failed: b_rptr did not increment on valid read");
assert property (read_pointer_unchanged) else $error("Read pointer failed: b_rptr changed unexpectedly");


// ============================================================
// Gray Pointer Properties
// ============================================================

// One-hot XOR: only one bit changes per valid transition
property write_gray_pointer_inc;
    @(posedge wclk) disable iff(!wrst_n)
    (~full && w_en) |=> $onehot(g_wptr ^ $past(g_wptr));
endproperty

property read_gray_pointer_inc;
    @(posedge rclk) disable iff(!rrst_n)
    (~empty && r_en) |=> $onehot(g_rptr ^ $past(g_rptr));
endproperty

property write_gray_pointer_unchanged;
    @(posedge wclk) disable iff(!wrst_n)
    (full || ~w_en) |=> $stable(g_wptr);
endproperty

property read_gray_pointer_unchanged;
    @(posedge rclk) disable iff(!rrst_n)
    (empty || ~r_en) |=> $stable(g_rptr);
endproperty

// Structural correctness: gray encoding matches binary at all times
property write_gray_matches_binary;
    @(posedge wclk) disable iff (!wrst_n)
    g_wptr == ((b_wptr >> 1) ^ b_wptr);
endproperty

property read_gray_matches_binary;
    @(posedge rclk) disable iff (!rrst_n)
    g_rptr == ((b_rptr >> 1) ^ b_rptr);
endproperty

assert property (write_gray_pointer_inc)      else $error("Buggy write gray pointer");
assert property (read_gray_pointer_inc)       else $error("Buggy read gray pointer");
assert property (write_gray_pointer_unchanged) else $error("Write gray pointer changed unexpectedly");
assert property (read_gray_pointer_unchanged)  else $error("Read gray pointer changed unexpectedly");
assert property (write_gray_matches_binary)   else $error("Write gray pointer does not match binary encoding");
assert property (read_gray_matches_binary)    else $error("Read gray pointer does not match binary encoding");


// ============================================================
// Full / Empty Flag Correctness (biconditional)
// ============================================================

property full_check;
    @(posedge wclk) disable iff (!wrst_n)
    (g_wptr == {~g_rptr_sync[A_WIDTH:A_WIDTH-1],
                g_rptr_sync[A_WIDTH-2:0]}) |-> full;
endproperty

property empty_check;
    @(posedge rclk) disable iff (!rrst_n)
    (g_rptr == g_wptr_sync) |-> empty;
endproperty

property full_implies_condition;
    @(posedge wclk) disable iff (!wrst_n)
    full |->
        (g_wptr == {~g_rptr_sync[A_WIDTH:A_WIDTH-1],
                    g_rptr_sync[A_WIDTH-2:0]});
endproperty

property empty_implies_condition;
    @(posedge rclk) disable iff (!rrst_n)
    empty |-> (g_rptr == g_wptr_sync);
endproperty

assert property (full_check)            else $error("FIFO FULL flag incorrect: condition met but full not set");
assert property (empty_check)           else $error("FIFO EMPTY flag incorrect: condition met but empty not set");
assert property (full_implies_condition) else $error("FULL asserted incorrectly");
assert property (empty_implies_condition) else $error("EMPTY asserted incorrectly");


// ============================================================
// Cover Points
// ============================================================

// FIFO reaches full
cover property (@(posedge wclk) disable iff (!wrst_n) full);

// Write pointer wraps around (MSB toggles)
cover property (@(posedge wclk) disable iff (!wrst_n)
    (~full && w_en) ##1
    (b_wptr[A_WIDTH] != $past(b_wptr[A_WIDTH])));

// Read pointer wraps around (MSB toggles)
cover property (@(posedge rclk) disable iff (!rrst_n)
    (~empty && r_en) ##1
    (b_rptr[A_WIDTH] != $past(b_rptr[A_WIDTH])));


endmodule

bind async_fifo fifo_properties inst (.*);