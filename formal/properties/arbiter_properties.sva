module arbiter_properties #(parameter N = 4) (
    input logic           clk,
    input logic           arst_n,
    input logic [N-1:0]   i_req,
    input logic [N-1:0]   o_grant,
    input logic [N-1:0]   mask_reg
);

property p_onehot;
    @(posedge clk) disable iff (!arst_n)
    $onehot0(o_grant);
endproperty
a_onehot: assert property (p_onehot);

property p_no_spurious;
    @(posedge clk) disable iff (!arst_n)
    (o_grant & ~i_req) == '0;
endproperty
a_no_spurious: assert property (p_no_spurious);

genvar i;
generate
    for (i = 0; i < N; i++) begin : gen_starvation
        property p_bounded_wait;
            @(posedge clk) disable iff (!arst_n)
            i_req[i] |-> (i_req[i] throughout ##[0:N-1] o_grant[i]);
        endproperty
        a_bounded_wait: assert property (p_bounded_wait);
    end
endgenerate

property p_no_deadlock;
    @(posedge clk) disable iff (!arst_n)
    |i_req |-> ##[0:N-1] |o_grant;
endproperty
a_no_deadlock: assert property (p_no_deadlock);

generate
    for (genvar i = 0; i < N; i++) begin : gen_mask_rotation

        localparam logic [N-1:0] EXPECTED_MASK =
            (i == N-1) ? '1 : ('1 << (i+1));

        assert property (
            @(posedge clk) disable iff (!arst_n)
            o_grant[i] |=> mask_reg == EXPECTED_MASK
        );

    end
endgenerate


endmodule

bind rr_arbiter arbiter_properties #(.N(N)) inst (.*);
